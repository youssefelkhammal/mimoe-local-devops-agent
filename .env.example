# Copy this file to .env, then replace these example values with the
# values shown by the API dialog in your own mimOE Studio installation.

# Use localhost when this program and mimOE run on the same computer.
# Otherwise, paste the complete Inference Base URL shown by mimOE Studio.
MIMOE_BASE_URL=http://localhost:8083/mimik-ai/openai/v1

# Paste the API key shown by mimOE Studio.
MIMOE_API_KEY=replace-with-your-mimoe-api-key

# Paste the exact identifier of the model that is active in mimOE Studio.
MIMOE_MODEL=replace-with-your-active-model-id

# Optional request timeout in seconds
MIMOE_TIMEOUT=60
